# =============================================================
# PRODE MUNDIAL - Environment Variables
# =============================================================
# Copy this file to .env.local and fill in your values

# Database (Neon, Supabase, or any PostgreSQL)
DATABASE_URL="postgresql://user:password@host:5432/prode_mundial?sslmode=require"
DIRECT_URL="postgresql://user:password@host:5432/prode_mundial?sslmode=require"

# Auth.js / NextAuth
AUTH_SECRET="your-secret-here-run-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"

# Google OAuth (https://console.cloud.google.com/)
AUTH_GOOGLE_ID="your-google-client-id"
AUTH_GOOGLE_SECRET="your-google-client-secret"

# Email (for magic links - use Resend, SendGrid, or SMTP)
EMAIL_SERVER_HOST="smtp.gmail.com"
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER="your-email@gmail.com"
EMAIL_SERVER_PASSWORD="your-app-password"
EMAIL_FROM="Prode Mundial <noreply@prode.com>"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Prode Mundial"

# Rate limiting (optional - use Upstash Redis)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
